{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "seogeoconsulting.hk" }],
      "destination": "https://www.seogeoconsulting.hk/:path*",
      "permanent": true
    },
    {
      "source": "/playbook.html",
      "destination": "/playbook",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/playbook",
      "destination": "/playbook.html"
    },
    {
      "source": "/:path([^/.]+)",
      "destination": "/index.html"
    }
  ]
}
